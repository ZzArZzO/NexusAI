# syntax=docker/dockerfile:1.7

# The always-on process: durable workflows, embedding backfills, scheduled work.

FROM node:24-alpine AS base
RUN corepack enable pnpm
WORKDIR /app

FROM base AS deps
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY apps/web/package.json apps/web/
COPY apps/worker/package.json apps/worker/
COPY packages/config/package.json packages/config/
COPY packages/core/package.json packages/core/
COPY packages/db/package.json packages/db/
COPY packages/ui/package.json packages/ui/
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    pnpm config set store-dir /pnpm/store && pnpm install --frozen-lockfile

FROM base AS builder
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/packages ./packages
COPY --from=deps /app/apps ./apps
COPY . .
ENV SKIP_ENV_VALIDATION=1
RUN pnpm --filter @nexusai/db generate && pnpm --filter @nexusai/worker build
RUN pnpm deploy --filter @nexusai/worker --prod /output

FROM base AS runner
ENV NODE_ENV=production
RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 worker

COPY --from=builder --chown=worker:nodejs /output ./
COPY --from=builder --chown=worker:nodejs /app/packages/db/generated ./packages/db/generated

USER worker
CMD ["node", "dist/index.js"]
