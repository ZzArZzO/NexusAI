# Normalise to LF in the repository regardless of the checkout platform.
# Without this, files authored on Windows land in the repo with CRLF and every
# Linux CI diff is noise.
* text=auto eol=lf

# Never touch these — a CRLF here breaks the shebang or the archive.
*.sh       text eol=lf
Dockerfile* text eol=lf
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.webp     binary
*.ico      binary
*.woff     binary
*.woff2    binary
*.pdf      binary

# Generated: collapse in diffs and exclude from language stats.
pnpm-lock.yaml linguist-generated=true -diff
