{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "NexusAI Next.js App",
  "extends": "./base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "allowJs": true,
    "types": ["node"],
    "plugins": [{ "name": "next" }]
  }
}
