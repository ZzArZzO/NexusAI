{
  "name": "@nexusai/integrations",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Connectors to the outside world: one folder per provider behind a single interface, with envelope-encrypted credentials and signature-verified webhooks.",
  "exports": {
    ".": "./src/index.ts",
    "./crypto": "./src/crypto.ts",
    "./connectors": "./src/connectors/index.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "rimraf dist .turbo coverage *.tsbuildinfo"
  },
  "dependencies": {
    "@nexusai/core": "workspace:*",
    "@nexusai/db": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nexusai/config": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "dotenv": "catalog:",
    "eslint": "catalog:",
    "rimraf": "6.1.2",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
