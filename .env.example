# Copy to .env and fill in. `.env` is gitignored — never commit real values.
# Every variable is validated at boot by packages/core/src/env/*.ts; a missing or
# malformed value fails fast with a readable message rather than an undefined
# three layers down.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3200
LOG_LEVEL=debug

NEXT_PUBLIC_APP_URL=http://localhost:3200

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Ports are offset from the defaults so this stack coexists with other projects
# already bound to 5432 and 3000.
DATABASE_URL=postgresql://nexus:nexus@localhost:55432/nexusai?schema=public

# Prisma Migrate needs to run DDL. Identical to DATABASE_URL locally; they differ
# only behind a transaction-mode pooler, which cannot run DDL.
DIRECT_DATABASE_URL=postgresql://nexus:nexus@localhost:55432/nexusai?schema=public

# Throwaway database used by `pnpm db:migrate:check` to replay migrations and
# detect schema drift. Prisma RESETS it on every run — never point at real data.
SHADOW_DATABASE_URL=postgresql://nexus:nexus@localhost:55432/nexusai_shadow?schema=public

# Integration tests TRUNCATE every table in this database between tests.
# Unset it and those tests skip rather than fail.
TEST_DATABASE_URL=postgresql://nexus:nexus@localhost:55432/nexusai_test?schema=public

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Signs session cookies. At least 32 characters.
#   openssl rand -base64 32
AUTH_SECRET=

# ---------------------------------------------------------------------------
# Model providers
# ---------------------------------------------------------------------------
# Leave blank to run against the mock provider: every agent path works and is
# tested, but answers are deterministic fakes and nothing is charged. Fill these
# in to switch to real models — no code change, no restart flag.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Orchestration (Inngest, self-hosted)
# ---------------------------------------------------------------------------
INNGEST_EVENT_KEY=local-dev-key
INNGEST_SIGNING_KEY=local-dev-signing-key
INNGEST_BASE_URL=http://localhost:58288

# ---------------------------------------------------------------------------
# Object storage (MinIO locally, S3-compatible)
# ---------------------------------------------------------------------------
STORAGE_ENDPOINT=http://localhost:59000
STORAGE_ACCESS_KEY=nexus
STORAGE_SECRET_KEY=nexussecret
STORAGE_BUCKET=nexusai

# ---------------------------------------------------------------------------
# Crypto
# ---------------------------------------------------------------------------
# Envelope-encrypts integration credentials at rest. Exactly 32 bytes, base64.
#   openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Seed (optional)
# ---------------------------------------------------------------------------
# SEED_WORKSPACE_SLUG=nexus
# SEED_WORKSPACE_NAME=NexusAI
# SEED_TIMEZONE=Europe/Lisbon
# SEED_CURRENCY=EUR
