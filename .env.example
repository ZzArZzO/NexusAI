# Copy to .env and fill in. `.env` is gitignored — never commit real values.
# Every variable here is validated at boot by packages/core/src/env/*.ts;
# a missing or malformed value fails fast with a readable message.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3200
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Pooled connection — used by the app at runtime through the Prisma driver adapter.
# Local docker compose:
DATABASE_URL=postgresql://nexus:nexus@localhost:55432/nexusai?schema=public
# Supabase (transaction pooler, port 6543):
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true

# Direct connection — used by Prisma Migrate, which needs to run DDL.
# PgBouncer in transaction mode cannot, which is why these two differ.
DIRECT_DATABASE_URL=postgresql://nexus:nexus@localhost:55432/nexusai?schema=public
# Supabase (direct, port 5432):
# DIRECT_DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Throwaway database used by `pnpm db:migrate:check` to replay migrations and
# detect schema drift. Prisma RESETS it on every run — never point this at real data.
SHADOW_DATABASE_URL=postgresql://nexus:nexus@localhost:55432/nexusai_shadow?schema=public

# Integration tests TRUNCATE every table in this database between tests.
# Never point it at anything you care about. Unset it and the integration
# tests skip rather than fail.
TEST_DATABASE_URL=postgresql://nexus:nexus@localhost:55432/nexusai_test?schema=public

# ---------------------------------------------------------------------------
# Supabase (auth + storage)
# ---------------------------------------------------------------------------
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_APP_URL=http://localhost:3200
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Model providers
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Orchestration (Inngest)
# ---------------------------------------------------------------------------
INNGEST_EVENT_KEY=local-dev-key
INNGEST_SIGNING_KEY=local-dev-signing-key
# Point at the local dev server started by docker compose.
INNGEST_BASE_URL=http://localhost:58288

# ---------------------------------------------------------------------------
# Crypto
# ---------------------------------------------------------------------------
# Envelope-encrypts integration credentials at rest. Exactly 32 bytes, base64.
# Generate with:  openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=
